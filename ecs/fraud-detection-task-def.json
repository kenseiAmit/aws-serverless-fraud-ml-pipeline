{
  "family": "fraud-detection-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/FraudDetectionECSTaskRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/FraudDetectionECSTaskRole",
  "containerDefinitions": [
    {
      "name": "fraud-detection-api",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/fraud-detection-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MODEL_S3_BUCKET",
          "value": "credit-card-fraud-pipeline-prod"
        },
        {
          "name": "MODEL_S3_PREFIX",
          "value": "model/fraud_detection_model_latest"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fraud-detection-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
